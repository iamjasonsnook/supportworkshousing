{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "crons": [
    { "path": "/api/admin/giving-digest?slot=13", "schedule": "0 13 * * 5" },
    { "path": "/api/admin/giving-digest?slot=14", "schedule": "0 14 * * 5" },
    { "path": "/api/admin/check-intake/sweep", "schedule": "0 11 * * *" }
  ],
  "rewrites": [
    { "source": "/api/admin/:path*", "destination": "/api/admin/[...path]" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/careers", "destination": "/index.html" },
    { "source": "/careers/(.*)", "destination": "/index.html" },
    { "source": "/impact-report", "destination": "/index.html" },
    { "source": "/SWHCapitalCampaign", "destination": "/index.html" }
  ]
}
